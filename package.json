{
  "name": "birdloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @birdloud/web",
    "dev:api": "npm run dev -w @birdloud/api",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "validate": "npm run check && npm run test && npm run build",
    "prisma:generate": "npm run prisma:generate -w @birdloud/api",
    "infra:up": "docker compose up -d postgres postgres-test redis mailpit",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @birdloud/api",
    "db:deploy": "npm run db:deploy -w @birdloud/api",
    "db:deploy:test": "npm run db:deploy:test -w @birdloud/api",
    "db:seed": "npm run db:seed -w @birdloud/api",
    "db:reset": "npm run db:reset -w @birdloud/api",
    "test:integration": "npm run test:integration -w @birdloud/api",
    "test:load": "npm run test:load -w @birdloud/api"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "vite": "^8.0.16",
    "esbuild": "^0.28.1"
  }
}
